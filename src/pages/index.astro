---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home | Jessynapse">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
        Welcome
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        PhD researcher transitioning to industry. Exploring the intersection of research and practical applications.
      </p>
    </div>

    <div class="mt-16">
      <div class="prose prose-lg mx-auto">
        <p>
          This portfolio showcases my research, projects, and journey from academia to industry.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

